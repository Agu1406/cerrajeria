---
/** Enlace a una página de barrio/zona. Usado en listados de cerrajero 24h, duplicado llaves coche, puertas antiokupas. */
const { href, title, subtitle } = Astro.props;
---

<a
  href={href}
  class="flex min-h-11 items-center justify-between gap-3 border-b border-[var(--line)] py-3 text-sm text-cream"
>
  <span class="min-w-0">
    <span class="block font-semibold">{title}</span>
    {subtitle && <span class="mt-1 block text-sm text-cream-muted">{subtitle}</span>}
  </span>
  <span class="shrink-0 font-medium text-gold-ink" aria-hidden="true">→</span>
</a>
