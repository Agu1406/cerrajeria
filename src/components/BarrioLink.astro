---
/** Enlace a una página de barrio/zona. Usado en listados de cerrajero 24h, duplicado llaves coche, puertas antiokupas. */
const { href, title, subtitle } = Astro.props;
---

<a
  href={href}
  class="flex min-h-11 flex-col justify-center py-2 text-sm text-cream hover:underline"
>
  <span class="font-semibold">{title}</span>
  {subtitle && <span class="mt-1 text-sm text-cream-muted">{subtitle}</span>}
</a>
