---
import { siteConfig } from '../config/site';
import type { Locale } from '../i18n/config';
import { DEFAULT_LOCALE } from '../i18n/config';
import { getCallFabStrings } from '../i18n/ui';
import { WHATSAPP_PREFILL } from '../i18n/ui';

interface Props {
  /** Si Layout lo pasa, incluye ya "Escribo desde: [url]". */
  whatsappHref?: string;
  locale?: Locale;
}

const { whatsappHref: whatsappHrefProp, locale = DEFAULT_LOCALE } = Astro.props;
const fab = getCallFabStrings(locale);
const whatsappHref =
  whatsappHrefProp ??
  (WHATSAPP_PREFILL[locale]
    ? `${siteConfig.whatsappUrl}?text=${encodeURIComponent(WHATSAPP_PREFILL[locale])}`
    : siteConfig.whatsappUrl);
---

<div class="sticky-cta" data-sticky-cta data-visible="true">
  <a
    href={siteConfig.telefonoHref}
    class="btn-call"
    aria-label={`${fab.callSiteAria} ${siteConfig.nombreComercial}`}
  >
    {fab.callLabel}
  </a>
  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-quiet"
    aria-label={fab.whatsappAria}
  >
    {fab.whatsappLabel}
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  if (bar) {
    document.body.classList.add('has-sticky');
    const sync = (window as Window & { __syncBottomDockHeight?: () => void }).__syncBottomDockHeight;
    if (typeof sync === 'function') sync();
  }
</script>
