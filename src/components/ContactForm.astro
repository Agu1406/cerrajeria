---
import type { Locale } from '../i18n/config';
import { DEFAULT_LOCALE } from '../i18n/config';

interface Props {
  barrio?: string;
  title?: string;
  subtitle?: string;
  locale?: Locale;
}

const { barrio, locale = DEFAULT_LOCALE } = Astro.props;
/** Inglés tiene formulario propio; otros idiomas usan español hasta tener traducción. */
const useEnglishForm = locale === 'en';
const title = Astro.props.title ?? (useEnglishForm ? 'Contact form' : 'Formulario de contacto');
const subtitle =
  Astro.props.subtitle ??
  (useEnglishForm ? 'For non-urgent enquiries, quotes or questions.' : 'Para consultas no urgentes, presupuestos o dudas.');

const labels = useEnglishForm
  ? {
      name: 'Name',
      nameOpt: '(optional)',
      namePh: 'Your name',
      mobile: 'Mobile',
      mobilePh: 'Phone number (optional)',
      email: 'Email',
      emailPh: 'you@example.com',
      message: 'Message',
      messagePh: barrio
        ? `Enquiry about locksmith service in ${barrio}…`
        : 'Tell us what you need (not an emergency)…',
      privacy: 'privacy policy',
      privacyCheck: 'I have read and accept the',
      privacyAfter: 'and I confirm that I am 14 or older.',
      privacyRequired: 'You must accept the privacy policy and confirm that you are 14 or older.',
      submit: 'Send message',
      sending: 'Sending…',
      success: "Message sent. We'll reply as soon as we can.",
      error: 'Could not send. Please try calling us.',
      network: 'Connection error. For emergencies, please call.',
    }
  : {
      name: 'Nombre',
      nameOpt: '(opcional)',
      namePh: 'Tu nombre',
      mobile: 'Móvil',
      mobilePh: 'Otro número o móvil',
      email: 'Correo',
      emailPh: 'tu@correo.com',
      message: 'Mensaje',
      messagePh: barrio ? `Consulta sobre cerrajería en ${barrio}...` : 'Cuéntanos qué necesitas (no urgente)...',
      privacy: 'política de privacidad',
      privacyCheck: 'He leído y acepto la',
      privacyAfter: 'y declaro que tengo 14 años o más.',
      privacyRequired: 'Debes aceptar la política de privacidad y declarar que tienes 14 años o más.',
      submit: 'Enviar consulta',
      sending: 'Enviando...',
      success: 'Mensaje enviado. Te responderemos lo antes posible.',
      error: 'No se pudo enviar. Prueba a llamarnos por teléfono.',
      network: 'Error de conexión. Llámanos por teléfono para urgencias.',
    };
---

<section class="text-sm">
  <h2 class="text-base font-semibold tracking-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-1 text-sm text-cream-muted">
      {subtitle}
    </p>
  )}

  <form
    class="ajax-form contact-form mt-4 space-y-4"
    action="/api/contact"
    method="post"
    data-barrio={barrio}
    data-msg-sending={labels.sending}
    data-msg-success={labels.success}
    data-msg-error={labels.error}
    data-msg-network={labels.network}
    data-msg-privacy={labels.privacyRequired}
    data-label-submit={labels.submit}
  >
    <input type="hidden" name="formTitle" value={title} />
    {barrio && (
      <input type="hidden" name="barrio" value={barrio} />
    )}
    <div class="space-y-1">
      <label for="contact-nombre" class="text-sm font-medium text-cream">
        {labels.name} <span class="text-cream-muted">{labels.nameOpt}</span>
      </label>
      <input
        id="contact-nombre"
        name="nombre"
        type="text"
        class="w-full rounded-[2px] border border-[var(--line)] bg-ink px-3 py-2 text-sm text-cream outline-none focus:border-brass"
        placeholder={labels.namePh}
      />
    </div>
    <div class="space-y-1">
      <label for="contact-movil" class="text-sm font-medium text-cream">
        {labels.mobile} <span class="text-cream-muted">{labels.nameOpt}</span>
      </label>
      <input
        id="contact-movil"
        name="movil"
        type="tel"
        class="w-full rounded-[2px] border border-[var(--line)] bg-ink px-3 py-2 text-sm text-cream outline-none focus:border-brass"
        placeholder={labels.mobilePh}
      />
    </div>
    <div class="space-y-1">
      <label for="contact-email" class="text-sm font-medium text-cream">
        {labels.email}
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        required
        class="w-full rounded-[2px] border border-[var(--line)] bg-ink px-3 py-2 text-sm text-cream outline-none focus:border-brass"
        placeholder={labels.emailPh}
      />
    </div>
    <div class="space-y-1">
      <label for="contact-mensaje" class="text-sm font-medium text-cream">
        {labels.message}
      </label>
      <textarea
        id="contact-mensaje"
        name="mensaje"
        rows="4"
        required
        class="w-full resize-none rounded-[2px] border border-[var(--line)] bg-ink px-3 py-2 text-sm text-cream outline-none focus:border-brass"
        placeholder={labels.messagePh}
      />
    </div>
    <div class="contact-form-feedback hidden" aria-live="polite"></div>
    <label class="flex items-start gap-2 text-sm text-cream">
      <input
        id="contact-privacy"
        name="privacyConsent"
        type="checkbox"
        required
        value="1"
        class="mt-0.5 h-4 w-4 shrink-0 rounded-[2px] border-[var(--line)] bg-ink text-brass focus:ring-brass"
      />
      <span>
        {labels.privacyCheck}{' '}
        <a href="/politica-privacidad" hreflang="es" class="text-brass underline">{labels.privacy}</a>{' '}
        {labels.privacyAfter}
      </span>
    </label>
    <button
      type="submit"
      class="ajax-form-submit contact-form-submit btn-call w-full"
    >
      {labels.submit}
    </button>
  </form>
</section>

<script>
  import { bindAjaxForm } from '../scripts/ajax-form';

  document.querySelectorAll('.ajax-form').forEach((node) => {
    bindAjaxForm(node as HTMLFormElement);
  });
</script>
