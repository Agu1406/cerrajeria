---
import { siteConfig } from '../config/site';
import {
  getafeBarrios,
  getafeCasosReales,
  getafeCodigosPostales,
  getafeComparativa,
  getafeFaqsExtra,
  getafePrecioTiers,
  getafeServiciosDestacados,
  getafeTrustPills,
} from '../data/getafe-local';
import ReviewsGrid from './ReviewsGrid.astro';

interface Props {
  whatsappHref: string;
}

const { whatsappHref } = Astro.props;
const direccion = siteConfig.direccion;
const profesional = siteConfig.profesional;
const fotoPath = profesional?.fotoPath;
---

<div class="space-y-10">
  <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-cream">
    {getafeTrustPills.map((pill) => (
      <li>{pill}</li>
    ))}
  </ul>

  <div class="flex flex-wrap items-center gap-3">
    <a
      href={siteConfig.telefonoHref}
      class="btn-call"
    >
      Llamar ahora: {siteConfig.telefono}
    </a>
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-quiet"
    >
      WhatsApp
    </a>
    <p class="text-sm text-cream-muted">En Getafe · Responde {profesional?.nombre} · 24h</p>
  </div>

  {profesional && (
    <section class="grid gap-6 sm:grid-cols-[minmax(0,11rem)_1fr]">
      <div class="mx-auto w-full max-w-[11rem] sm:mx-0">
        {fotoPath ? (
          <img
            src={fotoPath}
            alt={`${profesional.nombre}, cerrajero urgente en Getafe`}
            class="aspect-square w-full object-cover object-top"
            width="800"
            height="800"
            loading="lazy"
          />
        ) : (
          <div
            class="flex aspect-square w-full flex-col items-center justify-center px-3 text-center text-sm text-cream0"
            aria-hidden="true"
          >
            <span class="font-display text-3xl font-semibold text-cream0">{profesional.nombre.charAt(0)}</span>
            <span class="mt-2">{profesional.nombre}</span>
          </div>
        )}
      </div>
      <div>
        <h2 class="text-xl font-bold tracking-tight text-cream sm:text-2xl">
          Hola, soy {profesional.nombre}
        </h2>
        <p class="mt-1 text-sm font-medium text-cream">{profesional.titulo}</p>
        <p class="mt-3 text-sm text-cream">{profesional.bio}</p>
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-cream">
          <li>Autónomo registrado</li>
          <li>Factura con IVA</li>
          <li>Bizum y tarjeta</li>
          <li>Garantía por escrito</li>
          <li>Base en Getafe</li>
        </ul>
      </div>
    </section>
  )}

  <section class="space-y-4">
    <h2 class="text-xl font-bold tracking-tight sm:text-2xl">¿Cuánto va a costar?</h2>
    <p class="text-sm text-cream-muted">Precio orientativo confirmado por teléfono antes de salir.</p>
    <dl class="space-y-4 text-sm">
      {getafePrecioTiers.map((tier) => (
        <div>
          <dt class="font-semibold text-cream">{tier.nombre}: {tier.precio}</dt>
          <dd class="mt-1 text-cream">{tier.bullets.join('. ')}.</dd>
        </div>
      ))}
    </dl>
    <a href={siteConfig.telefonoHref} class="btn-call">Llamar: {siteConfig.telefono}</a>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-bold tracking-tight sm:text-2xl">
      Servicios de cerrajería urgente en Getafe
    </h2>
    <ul class="space-y-4 text-sm">
      {getafeServiciosDestacados.map((servicio) => (
        <li>
          <h3 class="font-semibold text-cream">
            {servicio.titulo} <span class="font-normal text-cream">({servicio.precio})</span>
          </h3>
          <p class="mt-1 text-cream">{servicio.bullets.join('. ')}.</p>
          <a href={servicio.href} class="text-gold-ink hover:underline">Ver más información</a>
        </li>
      ))}
    </ul>
  </section>

  {getafeCasosReales.length > 0 && (
    <section class="space-y-4">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">Situaciones que hemos resuelto en Getafe</h2>
      <ul class="space-y-4 text-sm">
        {getafeCasosReales.map((caso) => (
          <li>
            <h3 class="font-semibold text-cream">{caso.etiqueta}: {caso.titulo}</h3>
            <p class="mt-2 text-cream">{caso.resumen}</p>
            <p class="mt-2 text-cream">{caso.detalle}</p>
            {caso.precio && <p class="mt-2 text-cream">{caso.precio}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="space-y-4">
    <h2 class="text-xl font-bold tracking-tight sm:text-2xl">
      Cerrajero en todos los barrios de Getafe
    </h2>
    <p class="text-sm text-cream">
      Con base en {direccion?.calle ?? 'Getafe'}, atendemos urgencias en todo el municipio en 10–20 minutos.
    </p>
    <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-cream">
      {getafeBarrios.map((barrio) => (
        <li>{barrio}</li>
      ))}
    </ul>
    <p class="text-sm text-cream0">
      Códigos postales: {getafeCodigosPostales.join(', ')}.
    </p>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-bold tracking-tight sm:text-2xl">
      Por qué llamarnos si estás en Getafe
    </h2>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[320px] text-left text-sm">
        <thead class="border-b border-[var(--line)] text-sm text-cream-muted">
          <tr>
            <th class="px-4 py-3 font-semibold">Criterio</th>
            <th class="px-4 py-3 font-semibold text-gold-ink">{siteConfig.nombreComercial}</th>
            <th class="px-4 py-3 font-semibold">Otros cerrajeros</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--line)] text-cream">
          {getafeComparativa.map((row) => (
            <tr>
              <td class="px-4 py-3 text-cream-muted">{row.label}</td>
              <td class="px-4 py-3 font-medium text-cream">{row.nosotros}</td>
              <td class="px-4 py-3">{row.otros}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <ReviewsGrid />

  <section class="space-y-4 text-sm text-cream">
    <h2 class="text-xl font-bold tracking-tight text-cream sm:text-2xl">
      Cerrajero en Getafe: todo lo que necesitas saber
    </h2>
    {getafeFaqsExtra.map((faq) => (
      <div class="space-y-1">
        <h3 class="font-semibold text-cream">{faq.q}</h3>
        <p class="text-cream-muted">{faq.a}</p>
      </div>
    ))}
    <p>
      También cubrimos municipios cercanos:{' '}
      <a href="/cerrajero-urgente-24h/leganes" class="text-gold-ink hover:underline">Leganés</a>,{' '}
      <a href="/cerrajero-urgente-24h/fuenlabrada" class="text-gold-ink hover:underline">Fuenlabrada</a>,{' '}
      <a href="/cerrajero-urgente-24h/parla" class="text-gold-ink hover:underline">Parla</a>,{' '}
      <a href="/cerrajero-urgente-24h/pinto" class="text-gold-ink hover:underline">Pinto</a>,{' '}
      <a href="/cerrajero-urgente-24h/valdemoro" class="text-gold-ink hover:underline">Valdemoro</a> y{' '}
      <a href="/cerrajero-urgente-24h/villaverde" class="text-gold-ink hover:underline">Villaverde</a>.
    </p>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <p class="text-sm text-cream">¿Urgencia en Getafe? Te atiende {profesional?.nombre}.</p>
    <a href={siteConfig.telefonoHref} class="btn-call">
      {siteConfig.telefono}
    </a>
    <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="text-sm text-gold-ink hover:underline">
      WhatsApp
    </a>
  </div>
</div>
