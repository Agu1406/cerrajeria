---
import { siteConfig } from '../config/site';
import {
  getafeBarrios,
  getafeCodigosPostales,
  getafeComparativa,
  getafeFaqsExtra,
  getafeServiciosDestacados,
  getafeTrustPills,
} from '../data/getafe-local';

interface Props {
  whatsappHref: string;
}

const { whatsappHref } = Astro.props;
const reseñas = siteConfig.reseñas;
const direccion = siteConfig.direccion;
const reviewsConTexto =
  reseñas?.reseñas?.filter((r) => r.texto && !r.texto.includes('Reseña de 5 estrellas')) ?? [];
---

<div class="space-y-10">
  <div class="flex flex-wrap gap-2 text-xs">
    {getafeTrustPills.map((pill) => (
      <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 font-medium text-emerald-300">
        ✓ {pill}
      </span>
    ))}
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <a
      href={siteConfig.telefonoHref}
      class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-7 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-emerald-500/40 transition hover:bg-emerald-400"
    >
      Llamar ahora — {siteConfig.telefono}
    </a>
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-full border border-slate-600 px-6 py-3 text-sm font-semibold text-slate-100 transition hover:border-emerald-400 hover:text-emerald-300"
    >
      WhatsApp
    </a>
    <p class="text-xs text-slate-400">En Getafe · Responde {siteConfig.profesional.nombre} · 24h</p>
  </div>

  {siteConfig.profesional && (
    <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 sm:p-6">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-400">
        Cerrajero verificado · Getafe
      </p>
      <h2 class="mt-2 text-xl font-bold tracking-tight text-slate-100 sm:text-2xl">
        Hola, soy {siteConfig.profesional.nombre}
      </h2>
      <p class="mt-1 text-sm font-medium text-slate-300">{siteConfig.profesional.titulo}</p>
      <p class="mt-3 text-sm text-slate-400">{siteConfig.profesional.bio}</p>
      <ul class="mt-4 flex flex-wrap gap-2 text-xs text-slate-400">
        <li class="rounded-full border border-slate-700 px-3 py-1">🪪 Autónomo registrado</li>
        <li class="rounded-full border border-slate-700 px-3 py-1">🧾 Factura con IVA</li>
        <li class="rounded-full border border-slate-700 px-3 py-1">📍 Base en Getafe</li>
        <li class="rounded-full border border-slate-700 px-3 py-1">📞 Trato directo, sin call center</li>
      </ul>
    </section>
  )}

  <section class="space-y-4">
    <h2 class="text-xl font-bold tracking-tight sm:text-2xl">
      Servicios de cerrajería urgente en Getafe
    </h2>
    <p class="text-sm text-slate-400">
      Precio orientativo confirmado por teléfono antes de desplazarnos.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      {getafeServiciosDestacados.map((servicio) => (
        <article class="flex flex-col rounded-xl border border-slate-800 bg-slate-900/70 p-4">
          <div class="mb-2 flex items-start justify-between gap-2">
            <h3 class="text-sm font-semibold text-slate-100">{servicio.titulo}</h3>
            <span class="shrink-0 text-xs font-semibold text-emerald-400">{servicio.precio}</span>
          </div>
          <ul class="mb-4 flex-1 space-y-1 text-xs text-slate-400">
            {servicio.bullets.map((b) => (
              <li>✓ {b}</li>
            ))}
          </ul>
          <a href={servicio.href} class="text-xs font-medium text-emerald-400 hover:underline">
            Ver más información →
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-bold tracking-tight sm:text-2xl">
      Cerrajero en todos los barrios de Getafe
    </h2>
    <p class="text-sm text-slate-300">
      Con base en {direccion?.calle ?? 'Getafe'}, atendemos urgencias en todo el municipio en 10–20 minutos.
    </p>
    <ul class="grid gap-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
      {getafeBarrios.map((barrio) => (
        <li class="rounded-lg border border-slate-800 bg-slate-900/50 px-3 py-2 text-slate-300">
          {barrio}
        </li>
      ))}
    </ul>
    <p class="text-xs text-slate-500">
      Códigos postales: {getafeCodigosPostales.join(', ')}.
    </p>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-bold tracking-tight sm:text-2xl">
      Por qué llamarnos si estás en Getafe
    </h2>
    <p class="text-sm text-slate-400">
      Comparativa orientativa frente a cerrajeros que se desplazan desde Madrid capital.
    </p>
    <div class="overflow-x-auto rounded-xl border border-slate-800">
      <table class="w-full min-w-[320px] text-left text-sm">
        <thead class="border-b border-slate-800 bg-slate-900/80 text-xs uppercase tracking-wider text-slate-400">
          <tr>
            <th class="px-4 py-3 font-semibold">Criterio</th>
            <th class="px-4 py-3 font-semibold text-emerald-400">{siteConfig.nombreComercial}</th>
            <th class="px-4 py-3 font-semibold">Otros cerrajeros</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800 text-slate-300">
          {getafeComparativa.map((row) => (
            <tr>
              <td class="px-4 py-3 text-slate-400">{row.label}</td>
              <td class="px-4 py-3 font-medium text-slate-100">{row.nosotros}</td>
              <td class="px-4 py-3">{row.otros}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {reseñas && reseñas.totalResenas > 0 && (
    <section class="space-y-4">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">
        Opiniones de clientes en Google
      </h2>
      <p class="text-sm text-slate-300">
        <span class="text-amber-400">★★★★★</span>{' '}
        <strong>{reseñas.valoracionMedia}</strong> · {reseñas.totalResenas} reseñas en Google
      </p>
      {reviewsConTexto.length > 0 ? (
        <ul class="grid gap-3 sm:grid-cols-2">
          {reviewsConTexto.slice(0, 4).map((r) => (
            <li class="rounded-xl border border-slate-800 bg-slate-900/50 p-4 text-sm">
              <p class="text-slate-300">"{r.texto}"</p>
              <p class="mt-2 text-xs text-slate-500">
                — {r.autor} · {'★'.repeat(r.valoracion)}
              </p>
            </li>
          ))}
        </ul>
      ) : null}
      {siteConfig.googleMapsUrl && (
        <a
          href={siteConfig.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-sm font-medium text-emerald-400 hover:underline"
        >
          Ver reseñas en Google Maps →
        </a>
      )}
    </section>
  )}

  <section class="space-y-4 text-sm text-slate-300">
    <h2 class="text-xl font-bold tracking-tight text-slate-100 sm:text-2xl">
      Cerrajero en Getafe — todo lo que necesitas saber
    </h2>
    {getafeFaqsExtra.map((faq) => (
      <div class="space-y-1">
        <h3 class="font-semibold text-slate-100">{faq.q}</h3>
        <p class="text-slate-400">{faq.a}</p>
      </div>
    ))}
    <p>
      También cubrimos municipios cercanos:{' '}
      <a href="/cerrajero-urgente-24h/leganes" class="text-emerald-400 hover:underline">Leganés</a>,{' '}
      <a href="/cerrajero-urgente-24h/fuenlabrada" class="text-emerald-400 hover:underline">Fuenlabrada</a>,{' '}
      <a href="/cerrajero-urgente-24h/parla" class="text-emerald-400 hover:underline">Parla</a>,{' '}
      <a href="/cerrajero-urgente-24h/pinto" class="text-emerald-400 hover:underline">Pinto</a>,{' '}
      <a href="/cerrajero-urgente-24h/valdemoro" class="text-emerald-400 hover:underline">Valdemoro</a> y{' '}
      <a href="/cerrajero-urgente-24h/villaverde" class="text-emerald-400 hover:underline">Villaverde</a>.
    </p>
  </section>

  <div class="flex flex-wrap items-center gap-3 rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-4">
    <p class="text-sm text-slate-200">¿Urgencia en Getafe? Te atendemos ahora.</p>
    <a
      href={siteConfig.telefonoHref}
      class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-emerald-400"
    >
      📞 {siteConfig.telefono}
    </a>
    <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="text-sm text-emerald-400 hover:underline">
      WhatsApp
    </a>
  </div>
</div>
