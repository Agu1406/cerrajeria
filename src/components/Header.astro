---
import { siteConfig } from '../config/site';
import type { Locale } from '../i18n/config';
import { DEFAULT_LOCALE } from '../i18n/config';
import { getLanguageSwitchTargets, getNavStrings } from '../i18n/ui';
import { pathForRoute } from '../i18n/routes';
import { WHATSAPP_PREFILL } from '../i18n/ui';

interface Props {
  whatsappHref?: string;
  locale?: Locale;
}

const { whatsappHref: whatsappHrefProp, locale = DEFAULT_LOCALE } = Astro.props;
const nav = getNavStrings(locale);
const homePath = pathForRoute('home', locale);
const langLinks = getLanguageSwitchTargets(locale, 'home');

const whatsappHref =
  whatsappHrefProp ??
  (WHATSAPP_PREFILL[locale]
    ? `${siteConfig.whatsappUrl}?text=${encodeURIComponent(WHATSAPP_PREFILL[locale])}`
    : siteConfig.whatsappUrl);
---

<header class="border-b border-[var(--line)] bg-ink">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
    <a href={homePath} class="font-display text-xl font-semibold tracking-tight text-cream sm:text-2xl">
      {siteConfig.nombreComercial}
    </a>
    <nav class="hidden items-center gap-4 text-sm font-medium text-cream sm:flex" aria-label={nav.ariaNav}>
      <a href={homePath} class="nav-link">{nav.home}</a>
      <a href="/servicios" class="nav-link">{nav.services}</a>
      <a href="/cerrajero-urgente-24h" class="nav-link">{nav.areas}</a>
      <a href="/blog" class="nav-link">Blog</a>
      <a href="/contacto" class="nav-link">{nav.contact}</a>
      {langLinks.map((link) => (
        <a
          href={link.href}
          class="nav-link"
          hreflang={link.hreflang}
          lang={link.hreflang}
        >
          {link.label}
        </a>
      ))}
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-quiet"
        aria-label={nav.whatsappAria}
      >
        WhatsApp
      </a>
      <a
        href={siteConfig.telefonoHref}
        class="btn-call"
        aria-label={`${nav.callNow} ${siteConfig.telefono}`}
      >
        {nav.callNow} · {siteConfig.telefono}
      </a>
    </nav>
    <button
      type="button"
      id="menu-toggle"
      class="rounded-[2px] p-2 text-cream sm:hidden"
      aria-label={nav.openMenu}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span id="menu-icon" aria-hidden="true">☰</span>
    </button>
  </div>
  <div
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-[var(--line)] bg-ink px-4 py-3 sm:hidden"
    aria-label={nav.mobileMenuAria}
  >
    <a href={homePath} class="block rounded-[2px] px-3 py-2 text-cream">{nav.home}</a>
    <a href="/servicios" class="block rounded-[2px] px-3 py-2 text-cream">{nav.services}</a>
    <a href="/cerrajero-urgente-24h" class="block rounded-[2px] px-3 py-2 text-cream">{nav.areas}</a>
    <a href="/blog" class="block rounded-[2px] px-3 py-2 text-cream">Blog</a>
    <a href="/contacto" class="block rounded-[2px] px-3 py-2 text-cream">{nav.contact}</a>
    {langLinks.map((link) => (
      <a
        href={link.href}
        class="block rounded-[2px] px-3 py-2 text-cream"
        hreflang={link.hreflang}
        lang={link.hreflang}
      >
        {link.label}
      </a>
    ))}
    <div class="mt-2 flex flex-wrap gap-2">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-quiet"
        aria-label={nav.whatsappAria}
      >
        WhatsApp
      </a>
      <a
        href={siteConfig.telefonoHref}
        class="btn-call"
        aria-label={`${nav.callNow} ${siteConfig.telefono}`}
      >
        {nav.callMobile} · {siteConfig.telefono}
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var menuBtn = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var icon = document.getElementById('menu-icon');
    if (menuBtn && menu) {
      menuBtn.addEventListener('click', function () {
        var open = menu!.classList.toggle('hidden');
        menu!.classList.toggle('flex', !open);
        menuBtn!.setAttribute('aria-expanded', String(!open));
        var openLabel = document.documentElement.lang === 'en' ? 'Open menu' : 'Abrir menú';
        var closeLabel = document.documentElement.lang === 'en' ? 'Close menu' : 'Cerrar menú';
        menuBtn!.setAttribute('aria-label', open ? openLabel : closeLabel);
        if (icon) icon.textContent = open ? '☰' : '✕';
      });
    }
  });
</script>
