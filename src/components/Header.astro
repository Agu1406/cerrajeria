---
import { siteConfig } from '../config/site';
import type { Locale } from '../i18n/config';
import { DEFAULT_LOCALE } from '../i18n/config';
import { getLanguageSwitchTargets, getNavStrings } from '../i18n/ui';
import { pathForRoute } from '../i18n/routes';
import { WHATSAPP_PREFILL } from '../i18n/ui';

interface Props {
  whatsappHref?: string;
  locale?: Locale;
}

const { whatsappHref: whatsappHrefProp, locale = DEFAULT_LOCALE } = Astro.props;
const nav = getNavStrings(locale);
const homePath = pathForRoute('home', locale);
const langLinks = getLanguageSwitchTargets(locale, 'home');

const whatsappHref =
  whatsappHrefProp ??
  (WHATSAPP_PREFILL[locale]
    ? `${siteConfig.whatsappUrl}?text=${encodeURIComponent(WHATSAPP_PREFILL[locale])}`
    : siteConfig.whatsappUrl);
---

<header class="site-header border-b border-[var(--line)] bg-ink">
  <div class="site-header-wrap mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3 sm:gap-4 sm:py-4">
    <a
      href={homePath}
      class="brand flex min-h-11 items-center gap-2 font-display text-xl font-semibold tracking-tight text-cream sm:text-2xl"
    >
      <svg
        class="h-9 w-9 shrink-0 rounded-[2px]"
        viewBox="0 0 64 64"
        width="36"
        height="36"
        aria-hidden="true"
        focusable="false"
      >
        <rect width="64" height="64" fill="#E8EBEE"></rect>
        <path fill="#6E5518" d="M50 12H36L18 22v20l18 10h14v-8H38l-10-6V28l10-6h12z"></path>
      </svg>
      <span>{siteConfig.nombreComercial}</span>
    </a>
    <nav class="nav-desktop hidden items-center gap-4 text-sm font-medium text-cream sm:flex" aria-label={nav.ariaNav}>
      <a href={homePath} class="nav-link">{nav.home}</a>
      <a href="/servicios" class="nav-link">{nav.services}</a>
      <a href="/cerrajero-urgente-24h" class="nav-link">{nav.areas}</a>
      <a href="/blog" class="nav-link">Blog</a>
      <a href="/contacto" class="nav-link">{nav.contact}</a>
      {langLinks.map((link) => (
        <a
          href={link.href}
          class="nav-link"
          hreflang={link.hreflang}
          lang={link.hreflang}
        >
          {link.label}
        </a>
      ))}
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-quiet"
        aria-label={nav.whatsappAria}
      >
        WhatsApp
      </a>
      <a
        href={siteConfig.telefonoHref}
        class="btn-call"
        aria-label={`${nav.callNow} ${siteConfig.telefono}`}
      >
        {nav.callNow} · {siteConfig.telefono}
      </a>
    </nav>
    <div class="header-actions flex items-center gap-2 sm:hidden">
      <a
        href={siteConfig.telefonoHref}
        class="btn-call header-call"
        aria-label={`${nav.callMobile} ${siteConfig.telefono}`}
      >
        {nav.callMobile}
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="menu-toggle"
        aria-label={nav.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        {nav.menuLabel}
      </button>
    </div>
  </div>
  <nav
    id="mobile-menu"
    class="nav-mobile border-t border-[var(--line)] bg-ink sm:hidden"
    aria-label={nav.mobileMenuAria}
    data-menu
    hidden
  >
    <div class="mx-auto flex max-w-5xl flex-col px-4 py-2">
      <a href={homePath} class="nav-mobile-link">{nav.home}</a>
      <a href="/servicios" class="nav-mobile-link">{nav.services}</a>
      <a href="/cerrajero-urgente-24h" class="nav-mobile-link">{nav.areas}</a>
      <a href="/blog" class="nav-mobile-link">Blog</a>
      <a href="/contacto" class="nav-mobile-link">{nav.contact}</a>
      {langLinks.map((link) => (
        <a
          href={link.href}
          class="nav-mobile-link"
          hreflang={link.hreflang}
          lang={link.hreflang}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script define:vars={{ openLabel: nav.openMenu, closeLabel: nav.closeMenu }}>
  document.addEventListener('DOMContentLoaded', function () {
    var toggle = document.querySelector('[data-menu-toggle]');
    var menu = document.querySelector('[data-menu]');
    if (!toggle || !menu) return;

    function isOpen() {
      return toggle.getAttribute('aria-expanded') === 'true';
    }

    function trapTargets() {
      if (!isOpen()) return [];
      return [toggle].concat(Array.prototype.slice.call(menu.querySelectorAll('a')));
    }

    function setOpen(open) {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
      menu.hidden = !open;
      if (open) {
        var first = menu.querySelector('a');
        if (first) first.focus();
      } else {
        toggle.focus();
      }
    }

    toggle.addEventListener('click', function () {
      setOpen(!isOpen());
    });

    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        return;
      }
      if (e.key !== 'Tab' || !isOpen()) return;
      var items = trapTargets();
      if (!items.length) return;
      var first = items[0];
      var last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  });
</script>
