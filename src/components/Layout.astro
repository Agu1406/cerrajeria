---
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CallButton from './CallButton.astro';
import { siteConfig } from '../config/site';
import type { Locale } from '../i18n/config';
import { DEFAULT_LOCALE } from '../i18n/config';
import { getLayoutChrome } from '../i18n/ui';
import { WHATSAPP_PREFILL, whatsappPageUrlSuffix } from '../i18n/ui';

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** URL completa de la imagen para redes (og:image). Si no se pasa, se usa la imagen por defecto. */
  ogImage?: string;
  /** Breadcrumb para schema (ej. [{ name: 'Inicio', path: '/' }, { name: 'Cerrajero 24h', path: '/cerrajero-urgente-24h' }, { name: 'Las Rozas', path: '/cerrajero-urgente-24h/las-rozas' }]). */
  breadcrumb?: Array<{ name: string; path: string }>;
  /** Fecha ISO de última actualización del contenido (SEO frescura). Opcional. */
  dateModified?: string;
  /** Idioma de la página (UI, html lang, WhatsApp prefijado). */
  locale?: Locale;
  /** Etiquetas hreflang (URLs absolutas con dominio). Misma lista en todas las versiones enlazadas. */
  hreflangAlternates?: Array<{ hreflang: string; href: string }>;
};

const {
  title = siteConfig.titleHome,
  description = siteConfig.descriptionHome,
  noindex = false,
  ogImage,
  breadcrumb,
  dateModified,
  locale = DEFAULT_LOCALE,
  hreflangAlternates,
} = Astro.props as Props;

const chrome = getLayoutChrome(locale);

const baseUrlTrim = siteConfig.baseUrl.replace(/\/$/, '');
const defaultOgImage = `${baseUrlTrim}/images/cerrajero-24h-madrid-hero.webp`;
const imageForSocial = ogImage ?? defaultOgImage;

const businessLogoUrl = `${baseUrlTrim}${siteConfig.logoPath}`;

const reseñas = siteConfig.reseñas;
const direccion = siteConfig.direccion;
const schemaLocalBusiness: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['Locksmith', 'LocalBusiness'],
  name: siteConfig.nombreComercial,
  image: [businessLogoUrl],
  logo: businessLogoUrl,
  url: baseUrlTrim,
  telephone: siteConfig.telefono,
  ...(siteConfig.email && { email: siteConfig.email }),
  ...(siteConfig.sameAs?.length && { sameAs: siteConfig.sameAs }),
  ...(siteConfig.profesional && {
    founder: {
      '@type': 'Person',
      name: siteConfig.profesional.nombre,
      jobTitle: 'Cerrajero',
    },
  }),
  ...(direccion && {
    address: {
      '@type': 'PostalAddress',
      addressLocality: direccion.localidad,
      addressRegion: siteConfig.ciudadPrincipal,
      addressCountry: 'ES',
      streetAddress: direccion.calle,
      postalCode: direccion.codigoPostal,
    },
  }),
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  }],
  serviceArea: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: siteConfig.geoMidpoint.latitude,
      longitude: siteConfig.geoMidpoint.longitude,
    },
    geoRadius: 50000,
  },
};
if (reseñas && reseñas.totalResenas > 0) {
  schemaLocalBusiness.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: reseñas.valoracionMedia,
    bestRating: 5,
    worstRating: 1,
    reviewCount: reseñas.totalResenas,
  };
  if (reseñas.reseñas?.length) {
    const esTextoGenerico = (texto: string) =>
      /reseña de \d estrellas/i.test(texto) || texto.trim().length < 12;
    const reseñasConTexto = reseñas.reseñas.filter((r) => !esTextoGenerico(r.texto)).slice(0, 5);
    if (reseñasConTexto.length > 0) {
      schemaLocalBusiness.review = reseñasConTexto.map((r) => ({
        '@type': 'Review',
        author: { '@type': 'Person', name: r.autor },
        reviewRating: { '@type': 'Rating', ratingValue: r.valoracion, bestRating: 5 },
        reviewBody: r.texto,
        datePublished: r.fecha,
      }));
    }
  }
}

const normalizePathname = (pathname: string) => {
  if (pathname === '/') return '/';
  return pathname.replace(/\/+$/, '');
};

const canonicalPathname = normalizePathname(Astro.url.pathname);
const pageUrl = `${siteConfig.baseUrl.replace(/\/$/, '')}${canonicalPathname}`;
const whatsappPrefix = WHATSAPP_PREFILL[locale];
const whatsappHref = whatsappPrefix
  ? `${siteConfig.whatsappUrl}?text=${encodeURIComponent(whatsappPrefix + whatsappPageUrlSuffix(locale, pageUrl))}`
  : siteConfig.whatsappUrl;

const cookiePolicyPath = '/politica-cookies';
const gtmId = siteConfig.googleTagManagerId || '';
const gaId = !siteConfig.googleTagManagerId ? siteConfig.googleAnalyticsId || '' : '';
---

<html lang={chrome.htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="AKnVTlD2lp-EazjmFzbUqWu6RMPwILePS_sjqNB-dTY" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {siteConfig.isProductionSeo && (
      <>
        <link rel="canonical" href={`${siteConfig.baseUrl}${canonicalPathname}`} />
        {hreflangAlternates?.map((alt) => (
          <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
        ))}
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={`${siteConfig.baseUrl}${canonicalPathname}`} />
        <meta property="og:type" content="website" />
        <meta property="og:image" content={imageForSocial} />
        <meta property="og:locale" content={chrome.ogLocale} />
        <meta property="og:locale:alternate" content={chrome.ogLocaleAlternate} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageForSocial} />
      </>
    )}
    <title>{title}</title>
    {siteConfig.isProductionSeo && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaLocalBusiness)} />
    )}
    {siteConfig.isProductionSeo && breadcrumb && breadcrumb.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumb.map((item, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: item.name,
          item: `${siteConfig.baseUrl}${item.path ?? Astro.url.pathname}`,
        })),
      })} />
    )}
    {siteConfig.isProductionSeo && dateModified && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        url: `${siteConfig.baseUrl.replace(/\/$/, '')}${canonicalPathname}`,
        dateModified,
      })} />
    )}
    <script is:inline>
      (function() {
        try {
          var c = localStorage.getItem('cookie-consent');
          document.documentElement.dataset.cookieConsent =
            c === 'accepted' || c === 'rejected' ? 'given' : 'pending';
          document.documentElement.dataset.cookieChoice = c || '';
        } catch (e) {
          document.documentElement.dataset.cookieConsent = 'pending';
          document.documentElement.dataset.cookieChoice = '';
        }
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <a href="#main-content" class="skip-link">{chrome.skipLink}</a>
    <Header whatsappHref={whatsappHref} locale={locale} />
    <main id="main-content" class="mx-auto max-w-5xl px-4 py-10 sm:py-14" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <CallButton whatsappHref={whatsappHref} locale={locale} />
    <div id="cookie-banner" class="cookie-banner" role="dialog" aria-label={chrome.cookieAria} aria-live="polite">
      <p class="cookie-banner-text">
        {chrome.cookieText}{' '}
        <a href={cookiePolicyPath} class="underline hover:no-underline">{chrome.cookieMore}</a>.
      </p>
      <div class="cookie-banner-actions">
        <button type="button" id="cookie-banner-reject" class="cookie-banner-btn cookie-banner-btn--secondary">
          {chrome.cookieReject}
        </button>
        <button type="button" id="cookie-banner-accept" class="cookie-banner-btn">
          {chrome.cookieAccept}
        </button>
      </div>
    </div>
    <script is:inline define:vars={{ gtmId, gaId }}>
      (function() {
        var KEY = 'cookie-consent';
        var banner = document.getElementById('cookie-banner');
        var acceptBtn = document.getElementById('cookie-banner-accept');
        var rejectBtn = document.getElementById('cookie-banner-reject');
        var root = document.documentElement;

        function getConsent() {
          try { return localStorage.getItem(KEY); } catch (e) { return null; }
        }

        function hideBanner() {
          if (banner) banner.classList.add('cookie-banner--hidden');
        }

        function setConsent(value) {
          try { localStorage.setItem(KEY, value); } catch (e) {}
          root.dataset.cookieConsent = 'given';
          root.dataset.cookieChoice = value;
          hideBanner();
          try {
            window.dispatchEvent(new CustomEvent('cookie-consent-change', { detail: value }));
          } catch (e) {}
          if (value === 'accepted') loadAnalytics();
        }

        function loadGtm() {
          if (!gtmId || window.__gtmLoaded) return;
          window.__gtmLoaded = true;
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer',gtmId);
        }

        function loadGa() {
          if (!gaId || window.__gaLoaded) return;
          window.__gaLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId, { anonymize_ip: true });
        }

        function loadAnalytics() {
          loadGtm();
          loadGa();
          try {
            window.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
          } catch (e) {}
        }

        if (acceptBtn) acceptBtn.addEventListener('click', function() { setConsent('accepted'); });
        if (rejectBtn) rejectBtn.addEventListener('click', function() { setConsent('rejected'); });

        var current = getConsent();
        if (current === 'accepted' || current === 'rejected') {
          hideBanner();
          if (current === 'accepted') loadAnalytics();
        }
      })();
    </script>
    <script>
      import { inject } from '@vercel/analytics';

      function injectIfAccepted() {
        try {
          if (localStorage.getItem('cookie-consent') === 'accepted') {
            inject();
          }
        } catch {
          /* ignore */
        }
      }

      injectIfAccepted();
      window.addEventListener('cookie-consent-accepted', () => inject());
      window.addEventListener('cookie-consent-change', ((e: Event) => {
        const detail = (e as CustomEvent<string>).detail;
        if (detail === 'accepted') inject();
      }) as EventListener);
    </script>
  </body>
</html>
