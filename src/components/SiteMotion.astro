---
/** Línea del hero (CSS) + reveal al scroll. Sin Lenis ni GSAP. */
---

<script>
  import { initReveal } from '../scripts/reveal';

  function start() {
    initReveal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
</script>
