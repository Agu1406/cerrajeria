---
import Layout from '../Layout.astro';
import ContactForm from '../ContactForm.astro';
import { siteConfig } from '../../config/site';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/config';
import { getHreflangAlternatesForRoute, pathForRoute } from '../../i18n/routes';
import { HOME_FEATURED_BARRIO_SLUGS } from '../../i18n/home/constants';
import { buildHomeFaqSchema } from '../../i18n/home/schema';
import { getHomeCopy, getHomeFeaturedServicios } from '../../i18n/home/index';
import { WHATSAPP_PREFILL } from '../../i18n/ui';
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = getHomeCopy(locale);
const brand = siteConfig.nombreComercial;
const whatsappHref = WHATSAPP_PREFILL[locale]
  ? `${siteConfig.whatsappUrl}?text=${encodeURIComponent(WHATSAPP_PREFILL[locale])}`
  : siteConfig.whatsappUrl;
const whyTitle = copy.why.title.replace(/\{brand\}/g, brand);
const servicesTitle = copy.servicesSection.title.replace(/\{brand\}/g, brand);

const allBarrios = await getCollection('barrios');
const barriosDestacados: CollectionEntry<'barrios'>[] = HOME_FEATURED_BARRIO_SLUGS.map((slug) =>
  allBarrios.find((b) => b.slug === slug)
).filter((e): e is CollectionEntry<'barrios'> => Boolean(e));

const reseñas = siteConfig.reseñas;
const showReseñas = reseñas && reseñas.totalResenas > 0;

const faqSchema = buildHomeFaqSchema(copy.faqItems);
const featuredServicios = getHomeFeaturedServicios(copy);

const homePath = pathForRoute('home', locale);
const hreflangAlternates = getHreflangAlternatesForRoute(siteConfig.baseUrl, 'home');

const ratingSummary =
  showReseñas && reseñas
    ? copy.reviews.summaryGoogleTemplate
        .replace('{rating}', String(reseñas.valoracionMedia))
        .replace('{count}', String(reseñas.totalResenas))
    : '';
const ratingAria =
  showReseñas && reseñas
    ? copy.reviews.ratingAriaTemplate.replace('{rating}', String(reseñas.valoracionMedia))
    : '';
const ratingSub =
  showReseñas && reseñas && reseñas.totalResenas
    ? copy.stats.ratingSubCount.replace('{count}', String(reseñas.totalResenas))
    : copy.stats.ratingSubFallback;
---

<Layout
  locale={locale}
  title={copy.seo.title}
  description={copy.seo.description}
  hreflangAlternates={hreflangAlternates}
  breadcrumb={[{ name: copy.breadcrumbHome, path: homePath }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="grid gap-10 lg:grid-cols-[1.3fr_minmax(0,1fr)] lg:items-start">
    <div class="space-y-6">
      <p class="font-display text-4xl font-bold tracking-tight text-cream sm:text-5xl lg:text-6xl">
        {brand}
      </p>
      <h1 class="font-display text-2xl font-bold tracking-tight text-cream sm:text-3xl lg:text-4xl">
        {copy.heroTitle}
      </h1>
      <span class="hero-rule" data-hero-rule aria-hidden="true"></span>
      <p class="text-sm text-cream sm:text-base" set:html={copy.heroIntroHtml} />
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={siteConfig.telefonoHref}
          class="btn-call"
        >
          {copy.ctaCall} · {siteConfig.telefono}
        </a>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-quiet"
        >
          {copy.ctaWhatsApp}
        </a>
        <p class="w-full text-sm text-cream sm:w-auto">
          {copy.ctaSub}
        </p>
      </div>
      <ul class="mt-4 grid gap-2 text-sm text-cream sm:grid-cols-2">
        {copy.bullets.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    </div>
    <aside class="space-y-4">
      <h2 class="text-base font-semibold tracking-tight">
        {copy.areasTitle}
      </h2>
      <p class="text-sm text-cream-muted" set:html={copy.areasIntroHtml} />
      <ul class="grid gap-2 text-sm">
        {barriosDestacados.map((entry) => {
          const esBase = entry.slug === siteConfig.baseBarrioSlug;
          return (
          <li>
            <a
              href={`/cerrajero-urgente-24h/${entry.slug}`}
              {...(copy.areaLinksHreflang ? { hreflang: copy.areaLinksHreflang } : {})}
              class="flex min-h-11 items-center justify-between py-2 text-cream hover:underline"
            >
              <span>{esBase ? 'Cerrajero urgente Getafe' : entry.data.nombre}</span>
              <span class="text-sm text-cream-muted">{esBase ? 'Base · 10-20 min' : copy.barrioLinkSuffix}</span>
            </a>
          </li>
          );
        })}
      </ul>
      <a
        href="/cerrajero-urgente-24h"
        {...(copy.areaLinksHreflang ? { hreflang: copy.areaLinksHreflang } : {})}
        class="mt-3 inline-flex min-h-11 items-center text-sm font-medium text-brass hover:underline"
      >
        {copy.areasSeeAll}
      </a>
    </aside>
  </section>

  <dl class="mt-8 grid gap-6 text-sm sm:grid-cols-2">
    <div>
      <dt class="font-semibold text-cream">{copy.stats.arrivalLabel}</dt>
      <dd class="mt-1 text-cream">20–30 min. {copy.stats.arrivalSub}</dd>
    </div>
    <div>
      <dt class="font-semibold text-cream">{copy.stats.availLabel}</dt>
      <dd class="mt-1 text-cream">24/7. {copy.stats.availSub}</dd>
    </div>
    <div>
      <dt class="font-semibold text-cream">{copy.stats.priceLabel}</dt>
      <dd class="mt-1 text-cream">{copy.stats.priceValue}. {copy.stats.priceSub}</dd>
    </div>
    {showReseñas && reseñas ? (
      <div>
        <dt class="font-semibold text-cream">{copy.stats.ratingLabel}</dt>
        <dd class="mt-1 text-cream">{reseñas.valoracionMedia} de 5. {ratingSub}</dd>
      </div>
    ) : null}
  </dl>

  {showReseñas && reseñas && (
    <section class="reveal mt-10 space-y-4">
      <h2 class="text-lg font-semibold tracking-tight">
        {copy.reviews.title}
      </h2>
      {copy.reviews.noteHtml ? (
        <p class="text-sm text-cream-muted">{copy.reviews.noteHtml}</p>
      ) : null}
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <span class="text-cream" aria-label={ratingAria}>{reseñas.valoracionMedia} de 5</span>
        <span class="text-cream">{ratingSummary}</span>
        {siteConfig.googleMapsUrl && (
          <a
            href={siteConfig.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-brass hover:underline"
          >
            {copy.reviews.seeAllGoogle}
          </a>
        )}
      </div>
      {reseñas.reseñas?.length > 0 && (
        <ul class="grid gap-4 sm:grid-cols-2">
          {reseñas.reseñas.slice(0, 4).map((r) => (
            <li
              class="quote-rule text-sm"
              {...(copy.locale === 'en' ? { lang: 'es' } : {})}
            >
              <div class="mb-2 flex items-center justify-between gap-3">
                <span class="font-medium text-cream">{r.autor}</span>
                <span class="text-cream">{r.valoracion} de 5</span>
              </div>
              <p class="text-cream leading-relaxed">"{r.texto}"</p>
              <time datetime={r.fecha} class="mt-2 block text-sm text-cream-muted">
                {new Date(r.fecha).toLocaleDateString(copy.dateLocale, {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })}
              </time>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  <section class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
    <div class="space-y-3 text-sm text-cream">
      <h2 class="text-lg font-semibold tracking-tight">
        {copy.block24h.title}
      </h2>
      <p set:html={copy.block24h.bodyHtml} />
    </div>
    <figure>
      <picture>
        <source media="(max-width: 768px)" srcset="/images/cerrajero-24h-madrid-hero-662w.webp" type="image/webp" />
        <source
          srcset="/images/cerrajero-24h-madrid-hero.webp 1536w"
          type="image/webp"
          sizes="(max-width: 768px) 100vw, min(662px, 90vw)"
        />
        <img
          src="/images/cerrajero-24h-madrid-hero.webp"
          alt={copy.heroImageAlt}
          class="h-full w-full object-cover"
          width="1200"
          height="800"
          fetchpriority="high"
          sizes="(max-width: 768px) 100vw, min(662px, 90vw)"
        />
      </picture>
    </figure>
  </section>

  <section class="reveal mt-12 space-y-4 text-sm text-cream">
    <h2 class="text-lg font-semibold tracking-tight">
      {whyTitle}
    </h2>
    <p set:html={copy.why.leadHtml} />
    <ul class="space-y-4">
      {copy.why.cards.map((card) => (
        <li>
          <h3 class="text-base font-semibold text-cream">{card.title}</h3>
          <p class="mt-1 text-sm text-cream">{card.body}</p>
        </li>
      ))}
    </ul>

    <section class="mt-6 space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">
        {copy.faqSectionTitle}
      </h2>
      <div class="space-y-2 text-sm text-cream">
        {copy.faqInline.map((item) => (
          <p>
            <strong>{item.q}</strong> <span set:html={item.aHtml} />
          </p>
        ))}
      </div>
    </section>

    <section class="mt-8 space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">
        {servicesTitle}
      </h2>
      <p class="text-sm text-cream-muted" set:html={copy.servicesSection.introHtml} />
      <ul class="space-y-4">
        {featuredServicios.map((servicio) => (
          <li class="text-sm">
            <h3 class="font-semibold text-cream">{servicio.nombre}</h3>
            <p class="mt-1 text-cream">{servicio.descripcionCorta}</p>
          </li>
        ))}
      </ul>
      <p class="text-sm text-cream-muted" set:html={copy.servicesSection.footerHtml} />
    </section>

    <section class="mt-8 space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">
        {copy.zonesSection.title}
      </h2>
      <p class="text-sm text-cream-muted" set:html={copy.zonesSection.bodyHtml} />
      <p class="text-sm text-cream-muted">
        <a
          href={copy.zonesSection.linkHref}
          {...(copy.locale === 'en' ? { hreflang: 'es' } : {})}
          class="font-medium text-brass hover:underline"
        >
          {copy.zonesSection.linkText}
        </a>
      </p>
    </section>

    <section class="mt-10 max-w-xl">
      <ContactForm
        locale={copy.locale}
        title={copy.contactForm.title}
        subtitle={copy.contactForm.subtitle}
      />
    </section>
  </section>
</Layout>
