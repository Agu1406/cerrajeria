---
import Layout from '../Layout.astro';
import ContactForm from '../ContactForm.astro';
import Icon from '../Icon.astro';
import { MEDIA, siteConfig } from '../../config/site';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/config';
import { getHreflangAlternatesForRoute, pathForRoute } from '../../i18n/routes';
import { HOME_FEATURED_BARRIO_SLUGS } from '../../i18n/home/constants';
import { buildHomeFaqSchema } from '../../i18n/home/schema';
import { getHomeCopy, getHomeFeaturedServicios, HOME_STATS_ICONS } from '../../i18n/home/index';
import { WHATSAPP_PREFILL } from '../../i18n/ui';
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = getHomeCopy(locale);
const brand = siteConfig.nombreComercial;
const whatsappHref = WHATSAPP_PREFILL[locale]
  ? `${siteConfig.whatsappUrl}?text=${encodeURIComponent(WHATSAPP_PREFILL[locale])}`
  : siteConfig.whatsappUrl;
const whyTitle = copy.why.title.replace(/\{brand\}/g, brand);
const servicesTitle = copy.servicesSection.title.replace(/\{brand\}/g, brand);

const allBarrios = await getCollection('barrios');
const barriosDestacados: CollectionEntry<'barrios'>[] = HOME_FEATURED_BARRIO_SLUGS.map((slug) =>
  allBarrios.find((b) => b.slug === slug)
).filter((e): e is CollectionEntry<'barrios'> => Boolean(e));

const reseñas = siteConfig.reseñas;
const showReseñas = reseñas && reseñas.totalResenas > 0;

const faqSchema = buildHomeFaqSchema(copy.faqItems);
const featuredServicios = getHomeFeaturedServicios(copy);

const homePath = pathForRoute('home', locale);
const hreflangAlternates = getHreflangAlternatesForRoute(siteConfig.baseUrl, 'home');

const ratingAria =
  showReseñas && reseñas
    ? copy.reviews.ratingAriaTemplate.replace('{rating}', String(reseñas.valoracionMedia))
    : '';
const ratingSub =
  showReseñas && reseñas && reseñas.totalResenas
    ? copy.stats.ratingSubCount.replace('{count}', String(reseñas.totalResenas))
    : copy.stats.ratingSubFallback;

const workPhotoAlt = MEDIA.photoAlt.apertura;
const workPairs = MEDIA.workPairs
  .map((pair) => {
    const item = copy.works.items[pair.id];
    if (!item) return null;
    return { ...pair, ...item };
  })
  .filter((p): p is (typeof MEDIA.workPairs)[number] & (typeof copy.works.items)[string] => Boolean(p));
---

<Layout
  locale={locale}
  title={copy.seo.title}
  description={copy.seo.description}
  hreflangAlternates={hreflangAlternates}
  breadcrumb={[{ name: copy.breadcrumbHome, path: homePath }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="home-hero -mx-4 grid lg:mx-0 lg:min-h-[min(70vh,42rem)] lg:grid-cols-2 lg:items-stretch lg:gap-8">
    <div class="order-2 flex flex-col justify-center gap-5 px-4 py-8 lg:order-1 lg:px-0 lg:py-6">
      <p class="font-display text-4xl font-bold tracking-tight text-cream sm:text-5xl lg:text-6xl">
        {brand}
      </p>
      <h1 class="font-display text-2xl font-bold tracking-tight text-cream sm:text-3xl lg:text-4xl">
        {copy.heroTitle}
      </h1>
      <span class="hero-rule" data-hero-rule aria-hidden="true"></span>
      <p class="text-sm text-cream sm:text-base" set:html={copy.heroIntroHtml} />
      <div class="flex flex-wrap items-center gap-3">
        <a href={siteConfig.telefonoHref} class="btn-call">
          {copy.ctaCall} · {siteConfig.telefono}
        </a>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-quiet"
        >
          {copy.ctaWhatsApp}
        </a>
        <p class="w-full text-sm text-cream sm:w-auto">
          {copy.ctaSub}
        </p>
      </div>
    </div>
    <figure class="home-hero-media order-1 relative min-h-[16rem] overflow-hidden lg:order-2 lg:min-h-full">
      <picture>
        <source media="(max-width: 768px)" srcset="/images/cerrajero-24h-madrid-hero-662w.webp" type="image/webp" />
        <source
          srcset={`${MEDIA.heroPath} 1536w`}
          type="image/webp"
          sizes="(max-width: 1023px) 100vw, min(520px, 45vw)"
        />
        <img
          src={MEDIA.heroPath}
          alt={copy.heroImageAlt}
          class="h-full w-full object-cover lg:absolute lg:inset-0"
          width="1200"
          height="800"
          fetchpriority="high"
          sizes="(max-width: 1023px) 100vw, min(520px, 45vw)"
        />
      </picture>
      <div class="hero-scrim pointer-events-none absolute inset-x-0 bottom-0 h-1/2 lg:hidden" aria-hidden="true"></div>
    </figure>
  </section>

  <ul class="mt-8 grid gap-2 text-sm text-cream sm:grid-cols-2">
    {copy.bullets.map((line) => (
      <li>{line}</li>
    ))}
  </ul>

  <dl class="mt-10 grid gap-6 sm:grid-cols-2">
    <div>
      <dt class="flex items-center gap-2 text-sm text-cream-muted">
        <Icon name={HOME_STATS_ICONS.arrival} size={18} class="shrink-0 text-gold-ink" />
        {copy.stats.arrivalLabel}
      </dt>
      <dd>
        <p class="font-display text-2xl font-bold tracking-tight text-cream">20–30 min</p>
        <p class="mt-1 text-sm text-cream-muted">{copy.stats.arrivalSub}</p>
      </dd>
    </div>
    <div>
      <dt class="flex items-center gap-2 text-sm text-cream-muted">
        <Icon name={HOME_STATS_ICONS.availability} size={18} class="shrink-0 text-gold-ink" />
        {copy.stats.availLabel}
      </dt>
      <dd>
        <p class="font-display text-2xl font-bold tracking-tight text-cream">24/7</p>
        <p class="mt-1 text-sm text-cream-muted">{copy.stats.availSub}</p>
      </dd>
    </div>
    <div>
      <dt class="flex items-center gap-2 text-sm text-cream-muted">
        <Icon name={HOME_STATS_ICONS.price} size={18} class="shrink-0 text-gold-ink" />
        {copy.stats.priceLabel}
      </dt>
      <dd>
        <p class="font-display text-2xl font-bold tracking-tight text-cream">{copy.stats.priceValue}</p>
        <p class="mt-1 text-sm text-cream-muted">{copy.stats.priceSub}</p>
      </dd>
    </div>
    {showReseñas && reseñas ? (
      <div>
        <dt class="flex items-center gap-2 text-sm text-cream-muted">
          <Icon name={HOME_STATS_ICONS.rating} size={18} class="shrink-0 text-gold-ink" />
          {copy.stats.ratingLabel}
        </dt>
        <dd>
          <p class="font-display text-2xl font-bold tracking-tight text-cream">
            {reseñas.valoracionMedia} de 5
          </p>
          <p class="mt-1 text-sm text-cream-muted">{ratingSub}</p>
        </dd>
      </div>
    ) : null}
  </dl>

  {showReseñas && reseñas && (
    <section class="section-cream reveal -mx-4 mt-10 space-y-6 px-4 py-10">
      <div class="space-y-2">
        <h2 class="text-lg font-semibold tracking-tight">
          {copy.reviews.title}
        </h2>
        {copy.reviews.noteHtml ? (
          <p class="text-sm text-cream-muted">{copy.reviews.noteHtml}</p>
        ) : null}
        <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1" aria-label={ratingAria}>
          <span class="font-display text-2xl font-bold tracking-tight text-cream">
            {reseñas.valoracionMedia} de 5
          </span>
          <span class="text-sm text-cream-muted">{ratingSub}</span>
          {siteConfig.googleMapsUrl && (
            <a
              href={siteConfig.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-gold-ink hover:underline"
            >
              {copy.reviews.seeAllGoogle}
            </a>
          )}
        </p>
      </div>
      {reseñas.reseñas?.length > 0 && (
        <ul class="grid gap-6 sm:grid-cols-2">
          {reseñas.reseñas.slice(0, 4).map((r) => (
            <li
              class="quote-rule text-sm"
              {...(copy.locale === 'en' ? { lang: 'es' } : {})}
            >
              <div class="mb-3 flex items-baseline justify-between gap-3">
                <span class="font-medium text-cream">{r.autor}</span>
                <span class="shrink-0 text-cream-muted">{r.valoracion} de 5</span>
              </div>
              <p class="text-cream leading-relaxed">"{r.texto}"</p>
              <time datetime={r.fecha} class="mt-3 block text-sm text-cream-muted">
                {new Date(r.fecha).toLocaleDateString(copy.dateLocale, {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })}
              </time>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  <section class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center">
    <div class="space-y-3 text-sm text-cream">
      <h2 class="text-lg font-semibold tracking-tight">
        {copy.block24h.title}
      </h2>
      <p set:html={copy.block24h.bodyHtml} />
    </div>
    <figure class="overflow-hidden">
      <img
        src="/images/apertura-puerta-blindada.webp"
        alt={workPhotoAlt}
        class="h-full w-full object-cover"
        width="1200"
        height="800"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

  {workPairs.length > 0 && (
    <section class="reveal mt-12 space-y-4">
      <h2 class="text-lg font-semibold tracking-tight">{copy.works.title}</h2>
      <p class="text-sm text-cream-muted">{copy.works.intro}</p>
      <ul class="grid gap-8 sm:grid-cols-2">
        {workPairs.map((job) => (
          <li class="space-y-3">
            <p class="text-sm font-semibold text-cream">{job.caption}</p>
            <div class="grid grid-cols-2 gap-2">
              <figure class="space-y-1">
                <img
                  src={job.beforePath}
                  alt={job.beforeAlt}
                  class="aspect-[4/3] w-full bg-[var(--ink-soft)] object-cover object-center"
                  width="600"
                  height="450"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="text-sm font-medium text-cream-muted">{copy.works.beforeLabel}</figcaption>
              </figure>
              <figure class="space-y-1">
                <img
                  src={job.afterPath}
                  alt={job.afterAlt}
                  class="aspect-[4/3] w-full bg-[var(--ink-soft)] object-cover object-center"
                  width="600"
                  height="450"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="text-sm font-medium text-cream-muted">{copy.works.afterLabel}</figcaption>
              </figure>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="reveal mt-12 space-y-4">
    <h2 class="text-lg font-semibold tracking-tight">
      {copy.areasTitle}
    </h2>
    <p class="text-sm text-cream-muted" set:html={copy.areasIntroHtml} />
    <ul class="grid max-w-xl text-sm">
      {barriosDestacados.map((entry) => {
        const esBase = entry.slug === siteConfig.baseBarrioSlug;
        return (
          <li>
            <a
              href={`/cerrajero-urgente-24h/${entry.slug}`}
              {...(copy.areaLinksHreflang ? { hreflang: copy.areaLinksHreflang } : {})}
              class="flex min-h-11 items-center justify-between gap-3 border-b border-[var(--line)] py-3 text-cream"
            >
              <span class="font-semibold">{esBase ? 'Cerrajero urgente Getafe' : entry.data.nombre}</span>
              <span class="shrink-0 text-sm font-medium text-gold-ink">
                {esBase ? 'Base · 10-20 min' : copy.barrioLinkSuffix}
                <span aria-hidden="true"> →</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
    <a
      href="/cerrajero-urgente-24h"
      {...(copy.areaLinksHreflang ? { hreflang: copy.areaLinksHreflang } : {})}
      class="inline-flex min-h-11 items-center text-sm font-medium text-gold-ink hover:underline"
    >
      {copy.areasSeeAll}
    </a>
  </section>

  <section class="section-cream reveal -mx-4 mt-12 space-y-4 px-4 py-10 text-sm text-cream">
    <h2 class="text-lg font-semibold tracking-tight">
      {whyTitle}
    </h2>
    <p set:html={copy.why.leadHtml} />
    <ul class="mt-2">
      {copy.why.cards.map((card) => (
        <li class="border-b border-[var(--line)] py-4">
          <h3 class="text-base font-semibold text-cream">{card.title}</h3>
          <p class="mt-1 text-sm text-cream-muted">{card.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="reveal mt-12 space-y-3 text-sm text-cream">
    <h2 class="text-lg font-semibold tracking-tight">
      {copy.faqSectionTitle}
    </h2>
    <div class="faq-list">
      {copy.faqInline.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <div class="faq-a" set:html={item.aHtml} />
        </details>
      ))}
    </div>
  </section>

  <section class="section-cream reveal -mx-4 mt-12 space-y-3 px-4 py-10 text-sm text-cream">
    <h2 class="text-lg font-semibold tracking-tight">
      {servicesTitle}
    </h2>
    <p class="text-cream-muted" set:html={copy.servicesSection.introHtml} />
    <ul class="grid">
      {featuredServicios.map((servicio) => (
        <li>
          <a
            href={`/servicios/${servicio.slug}`}
            {...(copy.locale === 'en' ? { hreflang: 'es' } : {})}
            class="flex min-h-11 items-start justify-between gap-3 border-b border-[var(--line)] py-3 text-cream"
          >
            <span class="min-w-0">
              <span class="flex items-center gap-2 font-semibold">
                <Icon name={servicio.icon} size={22} class="shrink-0 text-gold-ink" />
                {servicio.nombre}
              </span>
              <span class="mt-1 block text-cream-muted">{servicio.descripcionCorta}</span>
            </span>
            <span class="shrink-0 pt-0.5 text-sm font-medium text-gold-ink">
              {copy.servicesSection.linkSuffix}
              <span aria-hidden="true"> →</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="text-cream-muted" set:html={copy.servicesSection.footerHtml} />
  </section>

  <section class="reveal mt-12 max-w-xl">
    <ContactForm
      locale={copy.locale}
      title={copy.contactForm.title}
      subtitle={copy.contactForm.subtitle}
    />
  </section>
</Layout>
