---
import Layout from '../../components/Layout.astro';
import { siteConfig } from '../../config/site';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const hasUpdatedDate =
  data.actualizado ? data.actualizado.getTime() !== data.pubDate.getTime() : false;

const title = `${data.title} | ${siteConfig.nombreComercial}`;
const description = data.description;
const ogImage = data.image ? `${siteConfig.baseUrl}${data.image}` : `${siteConfig.baseUrl}/images/cerrajero-24h-madrid-hero.webp`;
const noindex = entry.slug === 'medir-visitas-web-google-tag-manager-ga4';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.actualizado ?? data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: siteConfig.nombreComercial, url: siteConfig.baseUrl },
  publisher: { '@type': 'Organization', name: siteConfig.nombreComercial, url: siteConfig.baseUrl },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteConfig.baseUrl}/blog/${entry.slug}` },
};
---

<Layout {title} {description} ogImage={ogImage} {noindex}>
  {!noindex && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  <article class="mx-auto max-w-3xl">
    <header class="mb-10 space-y-4">
      <div class="text-sm text-cream0">
        <p>
          Publicado:{' '}
          <time datetime={data.pubDate.toISOString()}>
            {data.pubDate.toLocaleDateString('es-ES', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </time>
        </p>
        {hasUpdatedDate && data.actualizado && (
          <p class="mt-1">
            Última actualización:{' '}
            <time datetime={data.actualizado.toISOString()}>
              {data.actualizado.toLocaleDateString('es-ES', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </time>
          </p>
        )}
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight leading-tight sm:text-4xl">
        {data.title}
      </h1>
      <p class="text-base text-cream-muted leading-relaxed">
        {data.description}
      </p>
      {data.image && (
        <figure class="mt-6">
          <img
            src={data.image}
            alt={`Imagen destacada del artículo: ${data.title}`}
            class="w-full object-cover"
            width="800"
            height="450"
          />
        </figure>
      )}
    </header>

    <div class="blog-content border-t border-[var(--line)] pt-8 text-cream [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-cream [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-cream [&_p]:leading-relaxed [&_p]:mb-4 [&_a]:text-gold-ink [&_a]:underline [&_ul]:my-4 [&_ul]:list-inside [&_ul]:list-disc [&_ul]:space-y-2 [&_li]:leading-relaxed">
      <Content />
    </div>

    <footer class="mt-12 border-t border-[var(--line)] pt-6 text-sm text-cream-muted">
      <a href="/blog" class="inline-flex items-center gap-1 text-gold-ink hover:underline">← Volver al blog</a>
    </footer>
  </article>
</Layout>
