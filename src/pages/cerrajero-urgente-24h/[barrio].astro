---
import Layout from '../../components/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaLlamar from '../../components/CtaLlamar.astro';
import ContactForm from '../../components/ContactForm.astro';
import BarrioLink from '../../components/BarrioLink.astro';
import { siteConfig } from '../../config/site';
import { servicios } from '../../data/servicios';
import { getCollection, type CollectionEntry } from 'astro:content';
import { buildBarrioUrgenteDescription, buildBarrioUrgenteTitle } from '../../seo/snippets';
import { sortBarriosByPriority, isSurBarrioIndexable } from '../../seo/priority-barrios';
import GetafeLandingExtras from '../../components/GetafeLandingExtras.astro';
import SurBarrioExtras from '../../components/SurBarrioExtras.astro';
import { getafeFaqsExtra } from '../../data/getafe-local';
import { getSurBarrioZona } from '../../data/sur-barrio-zonas';
import { WHATSAPP_PREFILL, whatsappPageUrlSuffix } from '../../i18n/ui';

export async function getStaticPaths() {
  const entries = await getCollection('barrios');
  return entries.map((entry) => ({
    params: { barrio: entry.slug },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'barrios'>;
};

const { entry } = Astro.props as Props;
const data = entry.data;

const allBlogPosts = await getCollection('blog', ({ data: d }) => !d.draft);
const latestPosts = allBlogPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const esBaseOperativa = data.esBaseOperativa === true;
const surBarrioZona = !esBaseOperativa ? getSurBarrioZona(entry.slug) : undefined;
const title = data.seoTitle ?? buildBarrioUrgenteTitle(data.nombre, entry.slug);
const llegadaCorta = surBarrioZona
  ? surBarrioZona.llegada.replace(/\s*desde\s+Getafe\s*/i, '').trim()
  : undefined;
const description =
  data.seoDescription ?? buildBarrioUrgenteDescription(data.nombre, entry.slug, llegadaCorta);
const h1 = esBaseOperativa
  ? `Cerrajero urgente Getafe · 24 horas`
  : `Cerrajero urgente en ${data.nombre} · 24 horas`;
const basePath = '/cerrajero-urgente-24h';
const breadcrumb = [
  { name: 'Inicio', path: '/' },
  { name: 'Cerrajero 24h', path: basePath },
  { name: data.nombre, path: `${basePath}/${entry.slug}` },
];
const reseñas = siteConfig.reseñas;
const showReseñas = reseñas && reseñas.totalResenas > 0;

const allBarrios = await getCollection('barrios');
const otrasZonas = sortBarriosByPriority(allBarrios.filter((b) => b.slug !== entry.slug)).slice(0, 6);

/** Precios orientativos centralizados en site.ts (coherente con la home). */
const faqPrecioUrgencia = siteConfig.urgenciaPreciosFaqEs;

const faqItems = [
  { q: `¿Cuánto tardáis en llegar a ${data.nombre}?`, a: data.faqLlegada },
  { q: '¿El precio está cerrado antes de empezar?', a: faqPrecioUrgencia },
  { q: `¿Trabajáis también de noche y en festivos en ${data.nombre}?`, a: data.faqFestivos },
  ...(esBaseOperativa ? getafeFaqsExtra.map((f) => ({ q: f.q, a: f.a })) : []),
];

const pageUrl = `${siteConfig.baseUrl.replace(/\/$/, '')}/cerrajero-urgente-24h/${entry.slug}`;
const whatsappPrefix = WHATSAPP_PREFILL.es;
const whatsappHref = whatsappPrefix
  ? `${siteConfig.whatsappUrl}?text=${encodeURIComponent(whatsappPrefix + whatsappPageUrlSuffix('es', pageUrl))}`
  : siteConfig.whatsappUrl;

const faqSchemaBarrio = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
  ...(entry.data.actualizado && { dateModified: entry.data.actualizado.toISOString() }),
};
const dateModified = entry.data.actualizado?.toISOString();
const noindex = !isSurBarrioIndexable(entry.slug);
---

<Layout {title} {description} breadcrumb={breadcrumb} dateModified={dateModified} {noindex}>
  {!noindex && <script type="application/ld+json" set:html={JSON.stringify(faqSchemaBarrio)} />}
  <section class="space-y-6">
    <Breadcrumb items={breadcrumb} />
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
      {h1}
    </h1>
    <p class="text-sm text-cream sm:text-base">
      {esBaseOperativa ? (
        <>
          <strong class="text-cream">Cerrajero urgente en Getafe</strong> con base en Calle Progreso 2.
          Apertura de puertas sin daños desde{' '}
          <strong class="text-cream">{siteConfig.precioAperturaDesde} IVA incl.</strong>, cambio de
          cerraduras y asistencia en todo el municipio.
        </>
      ) : (
        <>
          Servicio de cerrajería urgente en {data.nombre} y alrededores. Apertura de puertas sin daños desde{' '}
          <strong class="text-cream">{siteConfig.precioAperturaDesde} IVA incl.</strong>, cambio de
          cerraduras y refuerzo de seguridad en viviendas, locales y comunidades de vecinos.
        </>
      )}
    </p>
    <p class="text-sm text-cream sm:text-base">
      {data.introExtra}
    </p>

    <div class="flex flex-wrap items-center gap-3">
      <CtaLlamar label="Llamar ahora" showPhone={false} />
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-quiet"
      >
        WhatsApp
      </a>
      <p class="text-sm text-cream-muted">
        {data.llegadaTexto}
        {esBaseOperativa && siteConfig.profesional ? ` · Responde ${siteConfig.profesional.nombre}` : ''}
      </p>
    </div>

    <p class="mt-2 text-sm text-cream">
      Apertura sin romper desde {siteConfig.precioAperturaDesde} IVA incl.{' '}
      <a href={siteConfig.telefonoHref} class="font-semibold text-brass hover:underline">
        {siteConfig.telefono}
      </a>
    </p>

    {showReseñas && !esBaseOperativa && !surBarrioZona && (
      <p class="mt-4 text-sm text-cream">
        <span aria-label={`Valoración: ${reseñas.valoracionMedia} de 5`}>{reseñas.valoracionMedia} de 5</span>
        {' '}· {reseñas.totalResenas} reseñas en Google
        {siteConfig.googleMapsUrl && (
          <a href={siteConfig.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-brass hover:underline">Ver reseñas</a>
        )}
      </p>
    )}

    {esBaseOperativa && (
      <div class="mt-8">
        <GetafeLandingExtras whatsappHref={whatsappHref} />
      </div>
    )}

    {surBarrioZona && <SurBarrioExtras zona={surBarrioZona} />}

    {!esBaseOperativa && !surBarrioZona && (
    <section class="mt-8 space-y-2 text-sm text-cream">
      <h2 class="text-base font-semibold tracking-tight">
        Cerrajeros en {data.nombre}: urgente y a domicilio
      </h2>
      <p>
        Servicio de <strong>cerrajero urgente 24 horas</strong> en {data.nombre} y alrededores: apertura de puertas sin daños, cambio de cerraduras y bombines, y arreglo de ventanas. Atendemos a domicilio las 24 horas todos los días del año.
      </p>
    </section>
    )}

    {!esBaseOperativa && !surBarrioZona && (
    <ul class="mt-6 space-y-4 text-sm">
      <li>
        <h2 class="mb-2 text-sm font-semibold">Urgencias sin daños</h2>
        <p class="text-cream">
          Apertura de puertas blindadas y acorazadas sin romper la cerradura siempre que sea posible. Explicamos
          el trabajo antes de empezar.
        </p>
      </li>
      <li>
        <h2 class="mb-2 text-sm font-semibold">Cambio e instalación de cerraduras</h2>
        <p class="text-cream">
          Cambiamos e instalamos cerraduras y bombines de alta seguridad, con opciones antibumping y antitaladro
          para viviendas y locales en {data.nombre}.
        </p>
      </li>
      <li>
        <h2 class="mb-2 text-sm font-semibold">Ventanas y herrajes</h2>
        <p class="text-cream">
          Arreglo de ventanas oscilobatientes y osciloparalelas, así como ajuste de herrajes y cierres que no
          encajan bien.
        </p>
      </li>
    </ul>
    )}

    {!esBaseOperativa && !surBarrioZona && (
    <section class="mt-8 space-y-3 text-sm text-cream">
      <h2 class="text-base font-semibold tracking-tight">
        Servicios habituales de cerrajería en {data.nombre}
      </h2>
      <p class="text-sm text-cream-muted">
        Trabajamos a diario con aperturas urgentes, cambios de cerradura y arreglos de ventanas. Estos son algunos
        de los servicios más demandados:
      </p>
      <ul class="grid gap-2 text-sm">
        {servicios.slice(0, 5).map((servicio) => (
          <li>• {servicio.nombre}</li>
        ))}
      </ul>
      <p class="text-sm text-cream-muted">
        Si necesitas un trabajo de cerrajería diferente en {data.nombre}, llámanos y te diremos al momento si
        podemos ayudarte.
      </p>
    </section>
    )}

    <section class="mt-8 space-y-3 text-sm text-cream">
      <h2 class="text-base font-semibold tracking-tight">
        Cómo trabajamos en {data.nombre}
      </h2>
      <p class="text-sm text-cream-muted">
        {data.comoTrabajamos}
      </p>
    </section>

    {!esBaseOperativa && (
    <section class="mt-8 space-y-3 text-sm text-cream">
      <h2 class="text-base font-semibold tracking-tight">
        Preguntas frecuentes sobre cerrajería urgente en {data.nombre}
      </h2>
      <div class="space-y-3 text-sm text-cream">
        {faqItems.map((item) => (
          <p>
            <strong>{item.q}</strong> {item.a}
          </p>
        ))}
      </div>
      {entry.data.actualizado && (
        <p class="mt-3 text-sm text-cream0">
          Contenido revisado: <time datetime={entry.data.actualizado.toISOString()}>{entry.data.actualizado.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}</time>
        </p>
      )}
    </section>
    )}

    {esBaseOperativa && entry.data.actualizado && (
      <p class="mt-3 text-sm text-cream0">
        Contenido revisado: <time datetime={entry.data.actualizado.toISOString()}>{entry.data.actualizado.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}</time>
      </p>
    )}

    <section class="mt-8 text-sm text-cream-muted">
      <p>
        Si quieres ver el detalle de todos los trabajos que realizamos como aperturas, cambios de cerradura o arreglos
        de ventanas, puedes visitar la página de{' '}
        <a href="/servicios" class="text-brass underline decoration-brass/60 hover:decoration-brass">
          servicios de cerrajería
        </a>
        .
      </p>
    </section>

    {otrasZonas.length > 0 && (
      <section class="mt-8 space-y-3">
        <h2 class="text-base font-semibold tracking-tight">
          Otras zonas donde atendemos
        </h2>
        <ul class="grid gap-2 text-sm sm:grid-cols-2">
          {otrasZonas.map((other) => (
            <li>
              <a
                href={`${basePath}/${other.slug}`}
                class="text-cream hover:text-brass hover:underline"
              >
                Cerrajero 24h en {other.data.nombre}
              </a>
            </li>
          ))}
        </ul>
        <p class="text-sm text-cream-muted">
          <a href={basePath} class="text-brass hover:underline">Ver todas las zonas</a>
        </p>
      </section>
    )}

    {latestPosts.length > 0 && (
      <section class="mt-10 space-y-3">
        <h2 class="text-base font-semibold tracking-tight">
          Últimas entradas del blog
        </h2>
        <ul class="space-y-2 text-sm">
          {latestPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.slug}`}
                class="text-cream hover:text-brass hover:underline"
              >
                {post.data.title}
              </a>
              <time datetime={post.data.pubDate.toISOString()} class="ml-2 text-sm text-cream-muted">
                {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-sm text-cream-muted">
          <a href="/blog" class="text-brass hover:underline">Ver todo el blog</a>
        </p>
      </section>
    )}

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <p class="text-sm text-cream">
        ¿Urgencia ahora? Llámanos y te atendemos en minutos.
      </p>
      <a
        href={siteConfig.telefonoHref}
        class="btn-call"
      >
        {siteConfig.telefono}
      </a>
    </div>

    <section class="mt-10">
      <h2 class="mb-3 text-lg font-semibold tracking-tight">
        Consulta para cerrajería en {data.nombre}
      </h2>
      <p class="mb-4 text-sm text-cream-muted">
        Si no es urgente, puedes enviarnos tu consulta y te respondemos lo antes posible.
      </p>
      <ContactForm
        barrio={data.nombre}
        title="Enviar consulta (no urgente)"
        subtitle="Presupuestos, dudas o trabajos planificados en esta zona."
      />
    </section>
  </section>
</Layout>
