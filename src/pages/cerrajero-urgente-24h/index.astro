---
import Layout from '../../components/Layout.astro';
import BarrioLink from '../../components/BarrioLink.astro';
import { siteConfig } from '../../config/site';
import { getCollection } from 'astro:content';
import { sortBarriosByPriority } from '../../seo/priority-barrios';

const title = `Cerrajero 24h sur Madrid · desde ${siteConfig.precioAperturaDesde} | ${siteConfig.nombreComercial}`;
const description = `Cerrajero urgente 24h en Getafe, Villaverde, Valdemoro, Fuenlabrada, Parla y Madrid capital. Apertura desde ${siteConfig.precioAperturaDesde} IVA incl. Llama: ${siteConfig.telefono}.`;

const barrios = sortBarriosByPriority(await getCollection('barrios'));
---

<Layout {title} {description}>
  <section class="space-y-6">
    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
      Cerrajero urgente 24h por barrios y zonas en {siteConfig.ciudadPrincipal}
    </h1>
    <p class="text-sm text-slate-300 sm:text-base">
      Servicio de cerrajería urgente con base en <strong>Getafe</strong>: priorizamos el sur de Madrid
      (Villaverde, Valdemoro, Fuenlabrada, Parla, Leganés…) y atendemos también los <strong>21 distritos de Madrid capital</strong>.
      Cada zona tiene su página con precio orientativo y teléfono de urgencias: <a href={siteConfig.telefonoHref} class="text-emerald-400 hover:underline">{siteConfig.telefono}</a>.
    </p>

    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {barrios.map((entry) => (
        <li>
          <BarrioLink
            href={`/cerrajero-urgente-24h/${entry.slug}`}
            title={entry.data.nombre}
            subtitle={`Cerrajero urgente 24h en ${entry.data.nombre}`}
          />
        </li>
      ))}
    </ul>
  </section>
</Layout>
