---
import Layout from '../../components/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaLlamar from '../../components/CtaLlamar.astro';
import ContactForm from '../../components/ContactForm.astro';
import { siteConfig } from '../../config/site';
import { servicios } from '../../data/servicios';

export async function getStaticPaths() {
  return servicios
    .filter((s) => s.slug !== 'duplicado-llaves-coche' && s.slug !== 'puertas-antiokupas')
    .map((servicio) => ({
      params: { servicio: servicio.slug },
      props: { servicio },
    }));
}

type Props = {
  servicio: (typeof servicios)[number];
};

const { servicio } = Astro.props as Props;
const isCambioCerradura = servicio.slug === 'cambio-cerradura';
const isAperturaPuertas = servicio.slug === 'apertura-puertas';
const isBombines = servicio.slug === 'bombines-seguridad';
const precio = siteConfig.precioAperturaDesde;

const title = isCambioCerradura
  ? `Cambio de cerradura en Madrid | Bombín y cilindro | ${siteConfig.nombreComercial}`
  : isAperturaPuertas
    ? `Apertura de puertas Madrid 24h | Desde ${precio} | ${siteConfig.nombreComercial}`
    : isBombines
      ? `Bombines de seguridad Madrid | Antibumping | ${siteConfig.nombreComercial}`
      : `${servicio.nombre} en Madrid | ${siteConfig.nombreComercial}`;

const description = isCambioCerradura
  ? `Cambio de cerradura, bombín o cilindro en Madrid y Comunidad. Cerradura rota o llaves perdidas. ${servicio.descripcionCorta} Tel. ${siteConfig.telefono}.`
  : isAperturaPuertas
    ? `Apertura de puertas sin romper desde ${precio} IVA incl. Blindadas y acorazadas. Urgencias 24h en Madrid y sur (Getafe). ☎ ${siteConfig.telefono}.`
    : isBombines
      ? `Bombines antibumping, antiganzúa y antitaladro en Madrid. Instalación a domicilio, factura con IVA y garantía por escrito. ☎ ${siteConfig.telefono}.`
      : `${servicio.nombre} en la Comunidad de Madrid. ${servicio.descripcionCorta} Llama al ${siteConfig.telefono}.`;

const basePath = '/servicios';
const breadcrumb = [
  { name: 'Inicio', path: '/' },
  { name: 'Servicios', path: basePath },
  { name: servicio.nombre, path: `${basePath}/${servicio.slug}` },
];

const otrosServicios = servicios
  .filter((s) => s.slug !== servicio.slug && s.slug !== 'duplicado-llaves-coche' && s.slug !== 'puertas-antiokupas')
  .slice(0, 4);
---

<Layout {title} {description} breadcrumb={breadcrumb}>
  <article class="space-y-8">
    <header class="space-y-4">
      <Breadcrumb items={breadcrumb} />
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
        {servicio.nombre} en Madrid
      </h1>
      <p class="text-sm text-slate-300 sm:text-base max-w-2xl">
        {servicio.descripcionCorta} Trabajamos en toda la Comunidad de Madrid y nos desplazamos a domicilio cuando hace falta.
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <CtaLlamar />
        <p class="text-xs text-slate-400">
          Presupuesto sin compromiso. Urgencias 24 horas.
        </p>
      </div>
    </header>

    {isCambioCerradura && (
      <section class="rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-5 sm:p-6 space-y-3 text-sm text-slate-300">
        <h2 class="text-lg font-semibold tracking-tight text-slate-50">
          Cambio de bombín, cilindro o cerradura completa
        </h2>
        <p>
          Mucha gente busca <strong class="text-slate-200">cambio de cerradura</strong> cuando en realidad basta con sustituir el{' '}
          <strong class="text-slate-200">bombín</strong> (también llamado <strong class="text-slate-200">cilindro</strong>). Otras
          veces la <strong class="text-slate-200">cerradura está rota</strong> o conviene cambiar el juego completo. En la visita
          valoramos la puerta y te proponemos la opción más adecuada y económica, con precio acordado antes de montar nada.
        </p>
        <p class="text-slate-400 text-xs">
          Si solo necesitas <a href={`${basePath}/bombines-seguridad`} class="text-emerald-400 hover:underline">bombines de alta seguridad</a>
          {' '}o <a href={`${basePath}/apertura-puertas`} class="text-emerald-400 hover:underline">apertura de puertas</a>, también lo cubrimos.
        </p>
      </section>
    )}

    {isAperturaPuertas && (
      <section class="rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-5 sm:p-6 space-y-3 text-sm text-slate-300">
        <h2 class="text-lg font-semibold tracking-tight text-slate-50">
          Apertura sin romper · desde {precio} IVA incl.
        </h2>
        <p>
          Abrimos puertas de vivienda, locales y portales priorizando técnicas <strong class="text-slate-200">no destructivas</strong>:
          llave dentro, llave perdida, bombín atascado o puerta blindada/acorazada. Te damos precio orientativo por teléfono
          y lo confirmamos en el sitio antes de empezar.
        </p>
        <ul class="list-disc space-y-1 pl-5 text-slate-400 text-xs sm:text-sm">
          <li>Urgencias 24 horas en Madrid y sur (base en Getafe)</li>
          <li>Precio cerrado antes de actuar · factura con IVA</li>
          <li>Bizum, tarjeta o efectivo · garantía por escrito</li>
        </ul>
        <p class="text-slate-400 text-xs">
          Si tras abrir conviene reforzar, también hacemos{' '}
          <a href={`${basePath}/cambio-cerradura`} class="text-emerald-400 hover:underline">cambio de cerradura</a>
          {' '}y{' '}
          <a href={`${basePath}/bombines-seguridad`} class="text-emerald-400 hover:underline">bombines de seguridad</a>.
        </p>
      </section>
    )}

    {isBombines && (
      <section class="rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-5 sm:p-6 space-y-3 text-sm text-slate-300">
        <h2 class="text-lg font-semibold tracking-tight text-slate-50">
          Bombín antibumping, antiganzúa y antitaladro
        </h2>
        <p>
          Un <strong class="text-slate-200">bombín de alta seguridad</strong> (cilindro) es la pieza que más protege tu puerta
          frente a bumping, ganzúa o taladro. Te asesoramos según el tipo de puerta y el nivel de riesgo; instalamos el mismo
          día si hay stock, con presupuesto acordado antes de montar.
        </p>
        <ul class="list-disc space-y-1 pl-5 text-slate-400 text-xs sm:text-sm">
          <li>Sustitución tras robo, llaves perdidas o upgrade de seguridad</li>
          <li>Factura con IVA · garantía por escrito · Bizum y tarjeta</li>
          <li>Compatible con la mayoría de cerraduras de vivienda y portal</li>
        </ul>
        <p class="text-slate-400 text-xs">
          Si la puerta no abre, primero{' '}
          <a href={`${basePath}/apertura-puertas`} class="text-emerald-400 hover:underline">apertura de puertas</a>
          {' '}y luego el cambio. También{' '}
          <a href={`${basePath}/cambio-cerradura`} class="text-emerald-400 hover:underline">cambio de cerradura completa</a>
          {' '}cuando hace falta.
        </p>
      </section>
    )}

    <section class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5 sm:p-6 space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">
        Atendemos en toda la Comunidad de Madrid
      </h2>
      <p class="text-sm text-slate-300">
        Este servicio está disponible en los mismos barrios y zonas donde prestamos cerrajería urgente: priorizamos Getafe,
        Villaverde, Valdemoro, Fuenlabrada, Parla, Leganés y el sur de Madrid; también el resto de la Comunidad. Puedes consultar
        zonas, tiempos de llegada y teléfono de urgencias en la página de barrios.
      </p>
      <p>
        <a href="/cerrajero-urgente-24h" class="font-semibold text-emerald-400 hover:underline">
          Ver barrios y zonas donde atendemos →
        </a>
      </p>
    </section>

    <section class="rounded-xl border border-slate-800 bg-slate-900/40 p-4 text-sm text-slate-300">
      <h2 class="text-base font-semibold tracking-tight mb-2">
        Otros servicios de cerrajería
      </h2>
      <p class="mb-3">
        Si necesitas otro trabajo (apertura de puertas, cambio de cerradura, duplicado de llaves, arreglo de ventanas, etc.), tenemos el listado completo en la página de servicios. Para urgencias 24 horas por zona, consulta los barrios.
      </p>
      <ul class="flex flex-wrap gap-x-2 gap-y-1">
        {otrosServicios.map((s, i) => (
          <li class="inline">
            <a href={`${basePath}/${s.slug}`} class="text-emerald-400 hover:underline">
              {s.nombre}
            </a>
            {i < otrosServicios.length - 1 && <span class="text-slate-500"> · </span>}
          </li>
        ))}
      </ul>
      <p class="mt-2">
        <a href={basePath} class="text-emerald-400 hover:underline">Ver todos los servicios →</a>
      </p>
    </section>

    <div class="flex flex-wrap items-center gap-3 rounded-xl border border-slate-800 bg-slate-900/50 p-4">
      <p class="text-sm text-slate-300">
        ¿Necesitas presupuesto o es una urgencia? Llámanos.
      </p>
      <a
        href={siteConfig.telefonoHref}
        class="inline-flex items-center justify-center rounded-full bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-emerald-400"
      >
        📞 {siteConfig.telefono}
      </a>
    </div>

    <section class="mt-8">
      <ContactForm
        title={`Solicitar presupuesto de ${servicio.nombre}`}
        subtitle="Para consultas no urgentes o presupuestos. Te respondemos lo antes posible."
      />
    </section>
  </article>
</Layout>
