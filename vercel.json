{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.loscerrajerosmadrid.es" }],
      "destination": "https://loscerrajerosmadrid.es/:path*",
      "permanent": true
    },
    {
      "source": "/barrios",
      "destination": "/cerrajero-urgente-24h",
      "permanent": true
    },
    {
      "source": "/barrios/:path*",
      "destination": "/cerrajero-urgente-24h/:path*",
      "permanent": true
    }
  ]
}
